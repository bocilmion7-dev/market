{
  "name": "marketplace",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build": "npx tsc -p apps/api/tsconfig.json && cd apps/web && npm install && npm run build",
    "postinstall": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/compression": "^1.8.1",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.2"
  }
}
